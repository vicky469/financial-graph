{
  "name": "@financial-graph/backend",
  "version": "1.0.0",
  "description": "Benchmarking and Playground for Financial Knowledge Graph with InstantDB",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "NODE_ENV=test vitest --run --exclude='**/integration/**'",
    "test:watch": "NODE_ENV=test vitest --exclude='**/integration/**'",
    "test:all": "NODE_ENV=test vitest --run --exclude='**/integration/**'",
    "test:integration": "NODE_ENV=test vitest --run tests/integration",
    "reload:dev": "bun src/scripts/reload-db.ts dev",
    "reload:test": "bun src/scripts/reload-db.ts test",
    "ingest:metadata": "bun src/data_source/sec/scripts/ingestSecMetadata.ts",
    "ingest:tickers": "bun src/ingest/tickers.ts",
    "ingest:filings": "bun src/ingest/filings.ts && bun src/ingest/ex21.ts && bun src/ingest/ex8.ts",
    "ingest:subsidiaries": "bun src/ingest/subsidiaries.ts",
    "download:ex21": "bun src/data_source/sec/scripts/download_exhibit_files.ts EX-21",
    "download:ex8": "bun src/data_source/sec/scripts/download_exhibit_files.ts EX-8",
    "fetch:sp500": "bun src/data_source/sp500/fetch-sp500-list.ts",
    "mark:sp500": "bun src/scripts/mark-sp500-companies.ts",
    "mark:trust": "bun src/scripts/mark-trust-companies.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "@financial-graph/shared": "workspace:*",
    "@instantdb/admin": "^0.22.96",
    "@instantdb/core": "^0.22.96",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "ollama": "^0.6.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.0.16",
    "fast-check": "^4.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
