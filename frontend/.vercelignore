# Ignore workspace files that might confuse Vercel
../package.json
../bun.lock
../node_modules
../shared
../backend
../.git

# Ignore local development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore build artifacts
dist/
build/
.next/

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
bun-error.log*