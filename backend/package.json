{
  "name": "@financial-graph/backend",
  "version": "0.1.0",
  "description": "Benchmarking and Playground for Financial Knowledge Graph with InstantDB",
  "main": "src/index.ts",
  "scripts": {
    "build": "cd ../shared && bun run build && cd ../backend && tsc",
    "build:shared": "cd ../shared && bun run build",
    "dev": "cd ../shared && bun run build && cd ../backend && bun --watch src/ui/start.ts",
    "schema:push": "bunx instant-cli@latest push schema",
    "perms:push": "bunx instant-cli@latest push perms",
    "test": "NODE_ENV=test vitest --run --exclude='**/integration/**'",
    "test:watch": "NODE_ENV=test vitest --exclude='**/integration/**'",
    "test:all": "NODE_ENV=test vitest --run --exclude='**/integration/**'",
    "test:integration": "NODE_ENV=test vitest --run tests/integration",
    "reload:dev": "bun src/scripts/reload-db.ts dev",
    "reload:test": "bun src/scripts/reload-db.ts test",
    "ingest:metadata": "bun src/data_source/sec/scripts/ingestSecMetadata.ts",
    "ingest:tickers": "bun src/ingest/tickers.ts",
    "ingest:filings": "bun src/ingest/filings.ts && bun src/ingest/ex21.ts && bun src/ingest/ex8.ts",
    "ingest:attachments": "bun src/ingest/ex21.ts && bun src/ingest/ex8.ts",
    "ingest:ex21": "bun src/ingest/ex21.ts",
    "ingest:ex8": "bun src/ingest/ex8.ts",
    "ingest:subsidiaries": "bun src/pipeline/subsidiaries/run.ts --sink=excel",
    "download:ex21": "bun src/data_source/sec/scripts/download_exhibit_files.ts EX-21",
    "download:ex8": "bun src/data_source/sec/scripts/download_exhibit_files.ts EX-8",
    "fetch:sp500": "bun src/data_source/sp500/fetch-sp500-list.ts",
    "fetch:tickers": "bun src/data_source/sec/scripts/fetch-company-tickers.ts",
    "fetch:tickers:r2": "bun src/data_source/sec/scripts/fetch-company-tickers.ts --storage=r2",
    "mark:sp500": "bun src/scripts/mark-sp500-companies.ts",
    "backfill:filing-dates": "bun src/scripts/backfill-filing-dates.ts",
    "backfill:filing-dates:test": "bun src/scripts/backfill-filing-dates.ts --dry-run --limit=5",
    "job:start": "cd ../shared && bun run build && cd ../backend && bun run build:ui && bun src/ui/start.ts",
    "job:dev": "cd ../shared && bun run build && cd ../backend && bun --watch src/ui/start.ts",
    "job:dev:full": "bun src/ui/dev-server.ts",
    "build:ui": "bun build src/ui/app.tsx --outdir src/ui --outfile app.js --target browser --format esm",
    "build:ui:watch": "bun build src/ui/app.tsx --outdir src/ui --outfile app.js --target browser --format esm --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@faker-js/faker": "^10.2.0",
    "@financial-graph/shared": "file:../shared",
    "@instantdb/admin": "^0.22.96",
    "@instantdb/core": "^0.22.96",
    "@instantdb/react": "^0.22.96",
    "@types/swagger-ui-express": "^4.1.8",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ollama": "^0.6.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "react-select": "^5.10.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/uuid": "^11.0.0",
    "@vitest/ui": "^4.0.16",
    "fast-check": "^4.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
