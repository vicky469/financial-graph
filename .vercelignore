# Ignore backend completely
backend/

# Ignore tools
tools/

# Ignore logs directories
logs/

# Ignore node_modules (will be installed fresh)
node_modules/

# Ignore local development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
bun-error.log*

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/tests/

# Ignore documentation
docs/
*.md
!README.md

# Ignore IDE files
.vscode/
.idea/
.DS_Store

# Ignore git
.git/
.gitignore
